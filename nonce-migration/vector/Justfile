set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

solana_version := "4.4.1"
# blueshift-gg/vector: the commit the Rust SDK, the vendored TypeScript SDK, and
# the program the validator loads all come from.
vector_commit := "f806f6cae32030098dc06d97bcd0f0aabed29a7e"

export VECTOR_COMMIT := vector_commit

_default:
    @just --list

# Setup

# Install Rust and TypeScript dependencies.
setup:
    cd rust && cargo fetch --locked
    cd ts && pnpm install

# Install the Anza CLI this directory is pinned to.
setup-solana:
    sh -c "$(curl -sSfL https://release.anza.xyz/v{{ solana_version }}/install)"
    solana --version

# Build the Vector program from the pinned commit into .local/programs/.
setup-programs:
    ./scripts/setup-programs.sh

# Re-copy the Ed25519 part of the TypeScript SDK out of the pinned commit into ts/web3js-v3/src/client/.
vendor-ts-client:
    ./scripts/vendor-ts-client.sh

# Formatting

fmt:
    cd rust && cargo fmt --all
    cd ts && pnpm exec oxfmt .

fmt-check:
    cd rust && cargo fmt --all --check
    cd ts && pnpm exec oxfmt --check .

# Linting

lint:
    cd rust && cargo clippy --locked --all-targets -- -D warnings
    cd ts && pnpm exec oxlint

typecheck:
    cd ts && pnpm exec tsc -p web3js-v3/tsconfig.json --noEmit

# Testing

# The tests are offline — no validator required.
test:
    cd rust && cargo test --locked
    cd ts/web3js-v3 && pnpm exec vitest run

# Everything CI runs, minus the examples, which need a validator.
check: fmt-check lint typecheck test

# Local validator

# Start a validator with the Vector program loaded.
validator-start:
    ./scripts/validator.sh start

validator-stop:
    ./scripts/validator.sh stop

# Examples (require a running validator: `just validator-start`)

# Sign a SOL transfer with a cold key, relay it after the signing-time blockhash expires, and reject a replay.
sign-relay:
    cd rust && cargo run --bin sign-relay

ts-sign-relay:
    cd ts/web3js-v3 && pnpm exec tsx src/sign-relay.ts

# Sign a token withdrawal with a cold key, creating the recipient's token account on the way, and relay it from a hot key.
token-transfer:
    cd rust && cargo run --bin token-transfer

ts-token-transfer:
    cd ts/web3js-v3 && pnpm exec tsx src/token-transfer.ts

# Two cold approvers sign one token withdrawal separately; a relay with one signature is rejected, with both it lands.
multi-signer:
    cd rust && cargo run --bin multi-signer

ts-multi-signer:
    cd ts/web3js-v3 && pnpm exec tsx src/multi-signer.ts

# A relay that lands and fails keeps its nonce, and the same signed action lands later.
failed-attempt:
    cd rust && cargo run --bin failed-attempt

ts-failed-attempt:
    cd ts/web3js-v3 && pnpm exec tsx src/failed-attempt.ts

# An action signed with a deadline is rejected once that slot has passed.
deadline:
    cd rust && cargo run --bin deadline

ts-deadline:
    cd ts/web3js-v3 && pnpm exec tsx src/deadline.ts

# Cancel a signed action by landing a revocation over the same nonce; the action is then rejected.
cancel:
    cd rust && cargo run --bin cancel

ts-cancel:
    cd ts/web3js-v3 && pnpm exec tsx src/cancel.ts

# Move a cold key's SOL, tokens, mint authorities, and locked stake to its system PDA in one checked transaction, then use them.
migrate:
    cd rust && cargo run --bin migrate

ts-migrate:
    cd ts/web3js-v3 && pnpm exec tsx src/migrate.ts

# Sign three actions at once, each over its own nonce account, and relay them out of order.
parallel:
    cd rust && cargo run --bin parallel

ts-parallel:
    cd ts/web3js-v3 && pnpm exec tsx src/parallel.ts

# Sign in a function that is given no network client, taking only the nonce from the online side.
airgapped:
    cd rust && cargo run --bin airgapped

ts-airgapped:
    cd ts/web3js-v3 && pnpm exec tsx src/airgapped.ts

# Run every example end to end against a fresh validator.
demo:
    just validator-start
    just _demo-inner || (just validator-stop && exit 1)
    just validator-stop

_demo-inner:
    just sign-relay
    just ts-sign-relay
    just token-transfer
    just ts-token-transfer
    just multi-signer
    just ts-multi-signer
    just failed-attempt
    just ts-failed-attempt
    just deadline
    just ts-deadline
    just cancel
    just ts-cancel
    just migrate
    just ts-migrate
    just parallel
    just ts-parallel
    just airgapped
    just ts-airgapped
