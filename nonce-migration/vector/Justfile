set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

solana_version := "4.4.1"
# blueshift-gg/vector: the commit the Rust SDK, the vendored TypeScript SDK, and
# the program the validator loads all come from.
vector_commit := "f806f6cae32030098dc06d97bcd0f0aabed29a7e"

export VECTOR_COMMIT := vector_commit

_default:
    @just --list

# Setup

# Install Rust and TypeScript dependencies.
setup:
    cd rust && cargo fetch --locked
    cd ts && pnpm install

# Install the Anza CLI this directory is pinned to.
setup-solana:
    sh -c "$(curl -sSfL https://release.anza.xyz/v{{ solana_version }}/install)"
    solana --version

# Build the Vector program from the pinned commit into .local/programs/.
setup-programs:
    ./scripts/setup-programs.sh

# Re-copy the Ed25519 part of the TypeScript SDK out of the pinned commit into ts/web3js-v3/src/client/.
vendor-ts-client:
    ./scripts/vendor-ts-client.sh

# Formatting

fmt:
    cd rust && cargo fmt --all
    cd ts && pnpm exec oxfmt .

fmt-check:
    cd rust && cargo fmt --all --check
    cd ts && pnpm exec oxfmt --check .

# Linting

lint:
    cd rust && cargo clippy --locked --all-targets -- -D warnings
    cd ts && pnpm exec oxlint

typecheck:
    cd ts && pnpm exec tsc -p web3js-v3/tsconfig.json --noEmit

# Testing

# The tests are offline — no validator required.
test:
    cd rust && cargo test --locked
    cd ts/web3js-v3 && pnpm exec vitest run

# Everything CI runs, minus the examples, which need a validator.
check: fmt-check lint typecheck test

# Local validator

# Start a validator with the Vector program loaded.
validator-start:
    ./scripts/validator.sh start

validator-stop:
    ./scripts/validator.sh stop

# Examples (require a running validator: `just validator-start`)

# Sign a SOL transfer with a cold key, relay it after the signing-time blockhash expires, and reject a replay.
sign-relay:
    cd rust && cargo run --bin sign-relay

ts-sign-relay:
    cd ts/web3js-v3 && pnpm exec tsx src/sign-relay.ts

# Sign a token withdrawal with a cold key, creating the recipient's token account on the way, and relay it from a hot key.
token-transfer:
    cd rust && cargo run --bin token-transfer

ts-token-transfer:
    cd ts/web3js-v3 && pnpm exec tsx src/token-transfer.ts

# Run every example end to end against a fresh validator.
demo:
    just validator-start
    just _demo-inner || (just validator-stop && exit 1)
    just validator-stop

_demo-inner:
    just sign-relay
    just ts-sign-relay
    just token-transfer
    just ts-token-transfer
